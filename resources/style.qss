/* ============================================================================
   StaX — style.qss   Cinematic Orchestrator design system
   ============================================================================

   CONTENTS
     1.  Nuclear dark base ............ QWidget / item views / scroll areas
     2.  Main window & splitter
     3.  Toolbar, menu bar & menus .... owns ALL QToolButton chrome
     4.  Status bar
     5.  LEFT panel ................... StacksListsPanel / #stacks_panel
     6.  CENTER panel ................. MediaDisplayWidget / #media_display
     7.  RIGHT panel .................. VideoPlayerWidget / #video_player_pane
     8.  Dock widgets ................. titles, float/close buttons, contents
     9.  Global widget fallbacks ...... scrollbars, buttons, inputs, combo/spin
                                        arrows, checkboxes, tabs, tree branches,
                                        headers, sliders, dialogs, tooltips
     10. Edge definition .............. VS-Code-like 1px boundaries + the
                                        borderless `toolicon` button class

   CASCADE — read before editing
     QSS has no !important; ties are broken by CSS specificity, then by source
     order. Section 10 is deliberately LAST so its borders win over sections
     1-9. Two consequences worth remembering:
       * A property set in section 10 cannot be overridden by adding it to an
         earlier section unless the selector is more specific.
       * Attribute selectors (e.g. [class="toolicon"]) outrank plain descendant
         type selectors (e.g. StacksListsPanel QPushButton).

   SURFACES
     #131313  toolbar / menu strip                #1f2020  hover
     #191a1a  LEFT nav + RIGHT preview (elevated) #262626  selected / cards
     #0e0e0e  CENTER media workbench (darkest)    #2c2c2c  menus / tooltips
     #71d7cd  accent (teal)                       #acabaa  muted text
     #e7e5e4  primary text                        #3c3c3c  edge / border

   ICONS
     Written as Qt-resource-style URLs and rewritten to absolute filesystem
     paths at load time by src/qss_loader.py — there is no compiled .qrc, the
     SVGs are plain files. Adding a new icon to this sheet needs no Python
     change; just drop the SVG into resources/icons/ and reference it the same
     way the existing rules do.

   PALETTE, NOT JUST QSS
     QAbstractItemView (QTreeWidget, QListWidget, QTableWidget) paints its
     background from QPalette::Base, NOT by widget inheritance — on Windows
     that is white regardless of QWidget { background }. src/dark_palette.py
     handles it app-wide; every item view and scroll-area viewport here is
     also overridden explicitly. Do not remove either half.

   PANEL SELECTORS
     Written twice — as a class name (MediaDisplayWidget) and as an objectName
     (#media_display) — because the class-name form only matches when the Qt
     meta-object registers the Python class. main.py sets all three
     objectNames in setup_ui(); keep them.
   ============================================================================ */


/* ── 1. NUCLEAR DARK BASE ────────────────────────────────────────────────────
   QWidget covers container widgets.
   QAbstractItemView MUST be listed separately — it does NOT inherit bg.
   QAbstractScrollArea viewport() is a plain QWidget child, also explicit. */

QWidget {
    background-color: #0e0e0e;
    color: #e7e5e4;
    border: none;
    outline: none;
    selection-background-color: rgba(113, 215, 205, 0.25);
    selection-color: #e7e5e4;
}

/* Item views: tree, list, table — QPalette::Base controls their fill */
QAbstractItemView {
    background-color: #0e0e0e;
    alternate-background-color: rgba(31, 32, 32, 0.6);
    color: #e7e5e4;
    border: none;
    outline: none;
    gridline-color: rgba(72, 72, 72, 0.10);
    selection-background-color: #262626;
    selection-color: #71d7cd;
    show-decoration-selected: 1;
}

QAbstractItemView::item {
    background-color: #0e0e0e;
    color: #acabaa;
    padding: 4px 8px;
    border: none;
}

QAbstractItemView::item:hover {
    background-color: #1f2020;
    color: #e7e5e4;
}

QAbstractItemView::item:selected {
    background-color: #262626;
    color: #71d7cd;
}

/* Scroll area viewports: the viewport() child is a plain QWidget */
QAbstractScrollArea {
    background-color: #0e0e0e;
}

QAbstractScrollArea > QWidget,
QAbstractScrollArea > QWidget > QWidget {
    background-color: #0e0e0e;
}

/* ── 2. MAIN WINDOW & SPLITTER ───────────────────────────────────────────── */

QMainWindow {
    background-color: #0e0e0e;
}

QMainWindow::separator {
    background-color: rgba(72, 72, 72, 0.12);
    width: 1px;
    height: 1px;
}

QSplitter {
    background-color: #0e0e0e;
}

QSplitter::handle {
    background-color: rgba(72, 72, 72, 0.12);
    width: 1px;
    height: 1px;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }


/* ── 3. TOOLBAR & MENU BAR ───────────────────────────────────────────────── */

QToolBar {
    background-color: #131313;
    border: none;
    border-bottom: 1px solid rgba(72, 72, 72, 0.14);
    padding: 3px 6px;
    spacing: 2px;
}

QToolBar::separator {
    background-color: rgba(72, 72, 72, 0.28);
    width: 1px;
    margin: 4px 3px;
}

QToolButton {
    background-color: #131313;
    color: #acabaa;
    border: none;
    border-radius: 5px;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #262626;
    color: #e7e5e4;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: rgba(113, 215, 205, 0.12);
    color: #71d7cd;
}

QMenuBar {
    background-color: #131313;
    color: #acabaa;
    border: none;
    border-bottom: 1px solid rgba(72, 72, 72, 0.14);
    padding: 2px 4px;
    font-size: 11px;
}

QMenuBar::item {
    background-color: #131313;
    padding: 4px 10px;
    border-radius: 4px;
    color: #acabaa;
}

QMenuBar::item:selected {
    background-color: #262626;
    color: #e7e5e4;
}

QMenuBar::item:pressed {
    background-color: #1f2020;
    color: #71d7cd;
}

QMenu {
    background-color: #2c2c2c;
    border: 1px solid rgba(72, 72, 72, 0.22);
    border-radius: 7px;
    padding: 5px 3px;
    font-size: 11px;
    color: #e7e5e4;
}

QMenu::item {
    background-color: #2c2c2c;
    padding: 6px 28px 6px 12px;
    border-radius: 4px;
    color: #e7e5e4;
    margin: 1px 3px;
}

QMenu::item:selected {
    background-color: #1f2020;
    color: #71d7cd;
}

QMenu::item:disabled {
    color: rgba(172, 171, 170, 0.35);
}

QMenu::separator {
    height: 1px;
    background-color: rgba(72, 72, 72, 0.18);
    margin: 4px 10px;
    border: none;
}


/* ── 4. STATUS BAR ───────────────────────────────────────────────────────── */

QStatusBar {
    background-color: #0e0e0e;
    color: #acabaa;
    font-size: 10px;
    border: none;
    border-top: 1px solid rgba(72, 72, 72, 0.13);
}

QStatusBar::item { border: none; }

QStatusBar QLabel {
    background-color: #0e0e0e;
    color: #acabaa;
    font-size: 10px;
    padding: 0 6px;
}


/* ══════════════════════════════════════════════════════════════════════════════
   5. LEFT PANEL — StacksListsPanel / #stacks_panel   (#191a1a — elevated)
   ════════════════════════════════════════════════════════════════════════════ */

/* Class name selector (works if Python class registers with Qt meta-object) */
StacksListsPanel {
    background-color: #191a1a;
    border: none;
    border-right: 1px solid rgba(72, 72, 72, 0.12);
}

/* objectName selector (guaranteed — requires setObjectName in Python) */
QWidget#stacks_panel {
    background-color: #191a1a;
    border: none;
    border-right: 1px solid rgba(72, 72, 72, 0.12);
}

/* All child QWidgets inside nav panel */
StacksListsPanel QWidget,
QWidget#stacks_panel QWidget {
    background-color: #191a1a;
}

/* Item views inside nav — override QAbstractItemView global rule */
StacksListsPanel QAbstractItemView,
QWidget#stacks_panel QAbstractItemView {
    background-color: #191a1a;
    alternate-background-color: #191a1a;
    border: none;
    outline: none;
    selection-background-color: #262626;
    selection-color: #71d7cd;
}

StacksListsPanel QAbstractItemView::item,
QWidget#stacks_panel QAbstractItemView::item {
    background-color: #191a1a;
    color: #acabaa;
    padding: 0 8px;
    height: 32px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
}

StacksListsPanel QAbstractItemView::item:hover,
QWidget#stacks_panel QAbstractItemView::item:hover {
    background-color: #1f2020;
    color: #e7e5e4;
}

StacksListsPanel QAbstractItemView::item:selected,
QWidget#stacks_panel QAbstractItemView::item:selected {
    background-color: #262626;
    color: #71d7cd;
    border-left: 3px solid #71d7cd;
}

/* Tree branch chrome.
   Styling ::branch at all hands branch painting to the stylesheet engine,
   which then draws NOTHING unless an image is supplied -- that is why the
   Stacks & Lists tree had no expand/collapse affordance at all. The images
   below restore it with the shared chevron set. */
StacksListsPanel QTreeView::branch,
QWidget#stacks_panel QTreeView::branch {
    background-color: #191a1a;
    border: none;
}

/* Scroll areas inside nav */
StacksListsPanel QAbstractScrollArea,
QWidget#stacks_panel QAbstractScrollArea {
    background-color: #191a1a;
}

StacksListsPanel QAbstractScrollArea > QWidget,
StacksListsPanel QAbstractScrollArea > QWidget > QWidget,
QWidget#stacks_panel QAbstractScrollArea > QWidget,
QWidget#stacks_panel QAbstractScrollArea > QWidget > QWidget {
    background-color: #191a1a;
}

/* Frame + QLabel inside nav */
StacksListsPanel QFrame,
QWidget#stacks_panel QFrame {
    background-color: #191a1a;
    border: none;
}

StacksListsPanel QLabel,
QWidget#stacks_panel QLabel {
    background-color: #191a1a;
    color: #acabaa;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
}

/* Buttons in nav */
StacksListsPanel QPushButton,
QWidget#stacks_panel QPushButton {
    background-color: #262626;
    color: #acabaa;
    border: none;
    border-radius: 5px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
}

StacksListsPanel QPushButton:hover,
QWidget#stacks_panel QPushButton:hover {
    background-color: #2c2c2c;
    color: #e7e5e4;
}

StacksListsPanel QPushButton:pressed,
QWidget#stacks_panel QPushButton:pressed {
    background-color: #1f2020;
    color: #71d7cd;
}

StacksListsPanel QPushButton:checked,
QWidget#stacks_panel QPushButton:checked {
    background-color: rgba(113, 215, 205, 0.10);
    color: #71d7cd;
}

/* The "New playlist" control is now an icon-only "+" (objectName `toolicon`)
   rather than a labelled CTA -- its chrome comes from the shared
   QPushButton[class="toolicon"] rule in section 10. The teal-gradient CTA
   rule that used to live here targeted #add_playlist_btn and is gone with it;
   don't reintroduce a filled CTA in a 260px nav column. */

/* Inputs in nav */
StacksListsPanel QLineEdit,
QWidget#stacks_panel QLineEdit {
    background-color: #262626;
    color: #e7e5e4;
    border: none;
    border-bottom: 2px solid rgba(113, 215, 205, 0);
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 11px;
}

StacksListsPanel QLineEdit:focus,
QWidget#stacks_panel QLineEdit:focus {
    border-bottom: 2px solid #71d7cd;
}

/* Scrollbar in nav */
StacksListsPanel QScrollBar:vertical,
QWidget#stacks_panel QScrollBar:vertical {
    background-color: #191a1a;
    width: 4px;
    border: none;
    margin: 0;
}

StacksListsPanel QScrollBar::handle:vertical,
QWidget#stacks_panel QScrollBar::handle:vertical {
    background-color: rgba(72, 72, 72, 0.50);
    border-radius: 2px;
    min-height: 20px;
}

StacksListsPanel QScrollBar::add-line:vertical,
StacksListsPanel QScrollBar::sub-line:vertical,
StacksListsPanel QScrollBar::add-page:vertical,
StacksListsPanel QScrollBar::sub-page:vertical,
QWidget#stacks_panel QScrollBar::add-line:vertical,
QWidget#stacks_panel QScrollBar::sub-line:vertical,
QWidget#stacks_panel QScrollBar::add-page:vertical,
QWidget#stacks_panel QScrollBar::sub-page:vertical {
    height: 0;
    background: #191a1a;
    border: none;
}

/* Divider lines in nav */
StacksListsPanel QFrame[frameShape="4"],
StacksListsPanel QFrame[frameShape="5"],
QWidget#stacks_panel QFrame[frameShape="4"],
QWidget#stacks_panel QFrame[frameShape="5"] {
    background-color: rgba(72, 72, 72, 0.15);
    max-height: 1px;
}


/* ══════════════════════════════════════════════════════════════════════════════
   6. CENTER PANEL — MediaDisplayWidget / #media_display   (#0e0e0e — darkest)
   Uses the global QAbstractItemView dark rule, just locks it explicitly.
   ════════════════════════════════════════════════════════════════════════════ */

MediaDisplayWidget,
QWidget#media_display {
    background-color: #0e0e0e;
    border: none;
}

MediaDisplayWidget QWidget,
QWidget#media_display QWidget {
    background-color: #0e0e0e;
}

MediaDisplayWidget QAbstractItemView,
QWidget#media_display QAbstractItemView {
    background-color: #0e0e0e;
    alternate-background-color: rgba(31, 32, 32, 0.5);
    border: none;
    outline: none;
    selection-background-color: #262626;
    selection-color: #71d7cd;
}

MediaDisplayWidget QAbstractItemView::item,
QWidget#media_display QAbstractItemView::item {
    background-color: #191a1a;
    color: #acabaa;
    border-radius: 6px;
    margin: 4px;
    border: 1px solid rgba(72, 72, 72, 0);
}

MediaDisplayWidget QAbstractItemView::item:hover,
QWidget#media_display QAbstractItemView::item:hover {
    background-color: #1f2020;
    color: #e7e5e4;
}

MediaDisplayWidget QAbstractItemView::item:selected,
QWidget#media_display QAbstractItemView::item:selected {
    background-color: #262626;
    color: #71d7cd;
    border: 1px solid rgba(113, 215, 205, 0.30);
}

MediaDisplayWidget QAbstractScrollArea,
QWidget#media_display QAbstractScrollArea {
    background-color: #0e0e0e;
}

MediaDisplayWidget QAbstractScrollArea > QWidget,
MediaDisplayWidget QAbstractScrollArea > QWidget > QWidget,
QWidget#media_display QAbstractScrollArea > QWidget,
QWidget#media_display QAbstractScrollArea > QWidget > QWidget {
    background-color: #0e0e0e;
}

MediaDisplayWidget QHeaderView,
QWidget#media_display QHeaderView {
    background-color: #0e0e0e;
}

MediaDisplayWidget QHeaderView::section,
QWidget#media_display QHeaderView::section {
    background-color: #131313;
    color: #acabaa;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid rgba(72, 72, 72, 0.15);
    border-right: 1px solid rgba(72, 72, 72, 0.08);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
}

MediaDisplayWidget QHeaderView::section:hover,
QWidget#media_display QHeaderView::section:hover {
    background-color: #191a1a;
    color: #e7e5e4;
}

MediaDisplayWidget QLabel,
QWidget#media_display QLabel {
    background-color: #0e0e0e;
    color: #acabaa;
    font-size: 11px;
}

MediaDisplayWidget QPushButton,
QWidget#media_display QPushButton {
    background-color: #262626;
    color: #acabaa;
    border: none;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
}

MediaDisplayWidget QPushButton:hover,
QWidget#media_display QPushButton:hover {
    background-color: #2c2c2c;
    color: #e7e5e4;
}

MediaDisplayWidget QPushButton:pressed,
MediaDisplayWidget QPushButton:checked,
QWidget#media_display QPushButton:pressed,
QWidget#media_display QPushButton:checked {
    background-color: rgba(113, 215, 205, 0.12);
    color: #71d7cd;
}

MediaDisplayWidget QLineEdit,
QWidget#media_display QLineEdit {
    background-color: #262626;
    color: #e7e5e4;
    border: none;
    border-bottom: 2px solid rgba(113, 215, 205, 0);
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 11px;
}

MediaDisplayWidget QLineEdit:focus,
QWidget#media_display QLineEdit:focus {
    border-bottom: 2px solid #71d7cd;
}

/* Size slider */
MediaDisplayWidget QSlider::groove:horizontal,
QWidget#media_display QSlider::groove:horizontal {
    height: 2px;
    background-color: #262626;
    border-radius: 1px;
}

MediaDisplayWidget QSlider::handle:horizontal,
QWidget#media_display QSlider::handle:horizontal {
    background-color: #71d7cd;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -5px 0;
}

MediaDisplayWidget QSlider::sub-page:horizontal,
QWidget#media_display QSlider::sub-page:horizontal {
    background-color: #71d7cd;
    border-radius: 1px;
}

MediaDisplayWidget QSlider::add-page:horizontal,
QWidget#media_display QSlider::add-page:horizontal {
    background-color: #262626;
    border-radius: 1px;
}

/* Scrollbar in center */
MediaDisplayWidget QScrollBar:vertical,
QWidget#media_display QScrollBar:vertical {
    background-color: #0e0e0e;
    width: 4px;
    border: none;
    margin: 0;
}

MediaDisplayWidget QScrollBar::handle:vertical,
QWidget#media_display QScrollBar::handle:vertical {
    background-color: rgba(72, 72, 72, 0.45);
    border-radius: 2px;
    min-height: 20px;
}

MediaDisplayWidget QScrollBar::add-line:vertical,
MediaDisplayWidget QScrollBar::sub-line:vertical,
MediaDisplayWidget QScrollBar::add-page:vertical,
MediaDisplayWidget QScrollBar::sub-page:vertical,
QWidget#media_display QScrollBar::add-line:vertical,
QWidget#media_display QScrollBar::sub-line:vertical,
QWidget#media_display QScrollBar::add-page:vertical,
QWidget#media_display QScrollBar::sub-page:vertical {
    height: 0;
    background: #0e0e0e;
    border: none;
}

MediaDisplayWidget QScrollBar:horizontal,
QWidget#media_display QScrollBar:horizontal {
    background-color: #0e0e0e;
    height: 4px;
    border: none;
    margin: 0;
}

MediaDisplayWidget QScrollBar::handle:horizontal,
QWidget#media_display QScrollBar::handle:horizontal {
    background-color: rgba(72, 72, 72, 0.45);
    border-radius: 2px;
    min-width: 20px;
}

MediaDisplayWidget QScrollBar::add-line:horizontal,
MediaDisplayWidget QScrollBar::sub-line:horizontal,
MediaDisplayWidget QScrollBar::add-page:horizontal,
MediaDisplayWidget QScrollBar::sub-page:horizontal,
QWidget#media_display QScrollBar::add-line:horizontal,
QWidget#media_display QScrollBar::sub-line:horizontal,
QWidget#media_display QScrollBar::add-page:horizontal,
QWidget#media_display QScrollBar::sub-page:horizontal {
    width: 0;
    background: #0e0e0e;
    border: none;
}


/* ══════════════════════════════════════════════════════════════════════════════
   7. RIGHT PANEL — VideoPlayerWidget / #video_player_pane  (#191a1a — elevated)
   ════════════════════════════════════════════════════════════════════════════ */

VideoPlayerWidget,
QWidget#video_player_pane {
    background-color: #191a1a;
    border: none;
    border-left: 1px solid rgba(72, 72, 72, 0.12);
}

VideoPlayerWidget QWidget,
QWidget#video_player_pane QWidget {
    background-color: #191a1a;
}

VideoPlayerWidget QAbstractItemView,
QWidget#video_player_pane QAbstractItemView {
    background-color: #191a1a;
    border: none;
    outline: none;
}

VideoPlayerWidget QAbstractScrollArea,
QWidget#video_player_pane QAbstractScrollArea {
    background-color: #191a1a;
}

VideoPlayerWidget QAbstractScrollArea > QWidget,
VideoPlayerWidget QAbstractScrollArea > QWidget > QWidget,
QWidget#video_player_pane QAbstractScrollArea > QWidget,
QWidget#video_player_pane QAbstractScrollArea > QWidget > QWidget {
    background-color: #191a1a;
}

VideoPlayerWidget QFrame,
QWidget#video_player_pane QFrame {
    background-color: #191a1a;
    border: none;
}

VideoPlayerWidget QLabel,
QWidget#video_player_pane QLabel {
    background-color: #191a1a;
    color: #acabaa;
    font-size: 11px;
}

/* Timeline — indigo playhead = "Time", not the teal "Process" colour */
VideoPlayerWidget QSlider::groove:horizontal,
QWidget#video_player_pane QSlider::groove:horizontal {
    height: 3px;
    background-color: #262626;
    border-radius: 2px;
}

VideoPlayerWidget QSlider::handle:horizontal,
QWidget#video_player_pane QSlider::handle:horizontal {
    background-color: #bac3ff;
    width: 13px;
    height: 13px;
    border-radius: 7px;
    margin: -5px 0;
    border: 2px solid #191a1a;
}

VideoPlayerWidget QSlider::handle:horizontal:hover,
QWidget#video_player_pane QSlider::handle:horizontal:hover {
    background-color: #dee0ff;
}

VideoPlayerWidget QSlider::sub-page:horizontal,
QWidget#video_player_pane QSlider::sub-page:horizontal {
    background-color: #71d7cd;
    border-radius: 2px;
}

VideoPlayerWidget QSlider::add-page:horizontal,
QWidget#video_player_pane QSlider::add-page:horizontal {
    background-color: #262626;
    border-radius: 2px;
}

VideoPlayerWidget QPushButton,
QWidget#video_player_pane QPushButton {
    background-color: #191a1a;
    color: #acabaa;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
}

VideoPlayerWidget QPushButton:hover,
QWidget#video_player_pane QPushButton:hover {
    background-color: #262626;
    color: #e7e5e4;
}

VideoPlayerWidget QPushButton:pressed,
QWidget#video_player_pane QPushButton:pressed {
    background-color: #1f2020;
    color: #71d7cd;
}

/* Action CTA buttons in preview */
VideoPlayerWidget QPushButton[objectName="insert_btn"],
VideoPlayerWidget QPushButton[objectName="reveal_btn"],
VideoPlayerWidget QPushButton[objectName="fetch_btn"],
QWidget#video_player_pane QPushButton[objectName="insert_btn"],
QWidget#video_player_pane QPushButton[objectName="reveal_btn"],
QWidget#video_player_pane QPushButton[objectName="fetch_btn"] {
    background-color: rgba(113, 215, 205, 0);
    color: #71d7cd;
    border: 1px solid rgba(113, 215, 205, 0.24);
    border-radius: 5px;
    padding: 8px 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
}

VideoPlayerWidget QPushButton[objectName="insert_btn"]:hover,
VideoPlayerWidget QPushButton[objectName="reveal_btn"]:hover,
VideoPlayerWidget QPushButton[objectName="fetch_btn"]:hover {
    background-color: rgba(113, 215, 205, 0.10);
    border-color: rgba(113, 215, 205, 0.40);
}

/* Ghost dividers in preview */
VideoPlayerWidget QFrame[frameShape="4"],
VideoPlayerWidget QFrame[frameShape="5"],
QWidget#video_player_pane QFrame[frameShape="4"],
QWidget#video_player_pane QFrame[frameShape="5"] {
    background-color: rgba(72, 72, 72, 0.14);
    max-height: 1px;
}

/* Scrollbar in preview */
VideoPlayerWidget QScrollBar:vertical,
QWidget#video_player_pane QScrollBar:vertical {
    background-color: #191a1a;
    width: 4px;
    border: none;
    margin: 0;
}

VideoPlayerWidget QScrollBar::handle:vertical,
QWidget#video_player_pane QScrollBar::handle:vertical {
    background-color: rgba(72, 72, 72, 0.45);
    border-radius: 2px;
    min-height: 20px;
}

VideoPlayerWidget QScrollBar::add-line:vertical,
VideoPlayerWidget QScrollBar::sub-line:vertical,
VideoPlayerWidget QScrollBar::add-page:vertical,
VideoPlayerWidget QScrollBar::sub-page:vertical,
QWidget#video_player_pane QScrollBar::add-line:vertical,
QWidget#video_player_pane QScrollBar::sub-line:vertical,
QWidget#video_player_pane QScrollBar::add-page:vertical,
QWidget#video_player_pane QScrollBar::sub-page:vertical {
    height: 0;
    background: #191a1a;
    border: none;
}


/* ══════════════════════════════════════════════════════════════════════════════
   8. DOCK WIDGETS — History, Settings, Analytics   (#191a1a)
   ════════════════════════════════════════════════════════════════════════════ */

QDockWidget {
    background-color: #191a1a;
    color: #e7e5e4;
    font-size: 11px;
    font-weight: 700;
    /* Title-bar button glyphs. These MUST be real images: `none` (the old
       value) left both buttons blank, so float/close were invisible hit
       targets. Resolved to absolute paths by src/qss_loader.py. */
    titlebar-close-icon: url(:/icons/dock_close.svg);
    titlebar-normal-icon: url(:/icons/dock_float.svg);
}

/* Right padding reserves the strip the two buttons are absolutely positioned
   into, so a long dock title can never run underneath them. */
QDockWidget::title {
    background-color: #131313;
    color: #acabaa;
    padding: 8px 62px 8px 14px;
    text-align: left;
    font-size: 10px;
    font-weight: 700;
    border: none;
    border-bottom: 1px solid rgba(72, 72, 72, 0.15);
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0px;
    width: 22px;
    height: 22px;
    icon-size: 14px;
    subcontrol-origin: margin;
    subcontrol-position: top right;
    top: 5px;
}

/* Both buttons anchor top-right, so the float button is offset left by its
   own width + gap; otherwise Qt stacks them on top of each other. */
QDockWidget::close-button { right: 6px; }
QDockWidget::float-button { right: 32px; }

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #262626;
    border-color: rgba(72, 72, 72, 0.45);
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background-color: #1f2020;
    border-color: #71d7cd;
}

/* Dock content widgets */
HistoryPanel,
SettingsPanel,
AnalyticsPanel {
    background-color: #191a1a;
}

HistoryPanel QWidget,
SettingsPanel QWidget,
AnalyticsPanel QWidget {
    background-color: #191a1a;
}

HistoryPanel QAbstractItemView,
SettingsPanel QAbstractItemView,
AnalyticsPanel QAbstractItemView {
    background-color: #191a1a;
    alternate-background-color: #1f2020;
    color: #acabaa;
    border: none;
    outline: none;
    selection-background-color: #262626;
    selection-color: #71d7cd;
}

HistoryPanel QAbstractItemView::item,
SettingsPanel QAbstractItemView::item,
AnalyticsPanel QAbstractItemView::item {
    background-color: #191a1a;
    color: #acabaa;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid rgba(72, 72, 72, 0.09);
}

HistoryPanel QAbstractItemView::item:hover,
AnalyticsPanel QAbstractItemView::item:hover {
    background-color: #262626;
    color: #e7e5e4;
}

HistoryPanel QAbstractScrollArea,
SettingsPanel QAbstractScrollArea,
AnalyticsPanel QAbstractScrollArea {
    background-color: #191a1a;
}

HistoryPanel QAbstractScrollArea > QWidget,
SettingsPanel QAbstractScrollArea > QWidget,
AnalyticsPanel QAbstractScrollArea > QWidget {
    background-color: #191a1a;
}

HistoryPanel QLabel,
SettingsPanel QLabel,
AnalyticsPanel QLabel {
    background-color: #191a1a;
    color: #acabaa;
    font-size: 11px;
}

/* Settings panel form elements */
SettingsPanel QGroupBox {
    background-color: #191a1a;
    border: 1px solid rgba(72, 72, 72, 0.20);
    border-radius: 7px;
    margin-top: 16px;
    padding-top: 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #acabaa;
}

SettingsPanel QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #acabaa;
    background-color: #191a1a;
}

SettingsPanel QScrollArea,
SettingsPanel QScrollArea > QWidget,
SettingsPanel QScrollArea > QWidget > QWidget {
    background-color: #191a1a;
}

/* Analytics tabs */
AnalyticsPanel QTabWidget::pane {
    background-color: #191a1a;
    border: none;
    border-top: 1px solid rgba(72, 72, 72, 0.15);
}

AnalyticsPanel QTabWidget > QWidget {
    background-color: #191a1a;
}

/* Panel-scoped tab rules only re-state the surface colour; sizing is
   inherited from the global QTabBar block (section 9) so tab metrics stay
   identical everywhere. */
AnalyticsPanel QTabBar {
    background-color: #131313;
    font-size: 11px;
    font-weight: 600;
}

AnalyticsPanel QTabBar::tab {
    background-color: #131313;
    color: #acabaa;
    padding: 8px 18px;
    min-width: 64px;
    min-height: 18px;
    font-size: 11px;
    font-weight: 600;
    border: none;
    border-bottom: 2px solid rgba(113, 215, 205, 0);
    margin-right: 3px;
}

AnalyticsPanel QTabBar::tab:selected {
    background-color: #131313;
    color: #71d7cd;
    border-bottom: 2px solid #71d7cd;
}

AnalyticsPanel QTabBar::tab:hover {
    background-color: #191a1a;
    color: #e7e5e4;
}

/* Header in history/analytics */
HistoryPanel QHeaderView::section,
SettingsPanel QHeaderView::section,
AnalyticsPanel QHeaderView::section {
    background-color: #131313;
    color: #acabaa;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid rgba(72, 72, 72, 0.15);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
}


/* ══════════════════════════════════════════════════════════════════════════════
   9. GLOBAL WIDGET FALLBACKS
   ════════════════════════════════════════════════════════════════════════════ */

/* Scrollbars — global 4px, no arrows */
QScrollBar:vertical {
    background-color: #0e0e0e;
    width: 4px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: rgba(72, 72, 72, 0.45);
    border-radius: 2px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(72, 72, 72, 0.75);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: #0e0e0e;
    border: none;
}

QScrollBar:horizontal {
    background-color: #0e0e0e;
    height: 4px;
    border: none;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: rgba(72, 72, 72, 0.45);
    border-radius: 2px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(72, 72, 72, 0.75);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    width: 0;
    background: #0e0e0e;
    border: none;
}

/* QPushButton */
QPushButton {
    background-color: #262626;
    color: #e7e5e4;
    border: none;
    border-radius: 5px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2c2c2c;
    color: #e7e5e4;
}

QPushButton:pressed {
    background-color: #1f2020;
    color: #71d7cd;
}

QPushButton:disabled {
    background-color: #191a1a;
    color: rgba(172, 171, 170, 0.32);
}

/* QLineEdit */
QLineEdit {
    background-color: #262626;
    color: #e7e5e4;
    border: none;
    border-bottom: 2px solid rgba(113, 215, 205, 0);
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 11px;
    selection-background-color: rgba(113, 215, 205, 0.25);
}

QLineEdit:focus {
    border-bottom: 2px solid #71d7cd;
}

QLineEdit:disabled {
    background-color: #191a1a;
    color: rgba(172, 171, 170, 0.35);
}

/* ── QComboBox ───────────────────────────────────────────────────────────────
   Fusion draws its own arrow only while the sub-control is unstyled; once the
   drop-down is styled the arrow disappears unless an explicit `image` is
   given. Both were previously styled without an image, so combo boxes and
   spin boxes shipped with no visible affordance at all. */

QComboBox {
    background-color: #262626;
    color: #e7e5e4;
    border: none;
    border-bottom: 2px solid rgba(113, 215, 205, 0);
    border-radius: 5px;
    /* right padding clears the drop-down strip so text never slides under it */
    padding: 5px 30px 5px 10px;
    font-size: 11px;
    min-height: 18px;
}

QComboBox:hover {
    background-color: #2c2c2c;
}

QComboBox:focus {
    border-bottom: 2px solid #71d7cd;
}

QComboBox::drop-down {
    background-color: transparent;
    border: none;
    border-left: 1px solid rgba(72, 72, 72, 0.30);
    width: 24px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron_down.svg);
    width: 11px;
    height: 11px;
}

/* Popup open, or pointer over the control: flip/tint the chevron. */
QComboBox::down-arrow:on {
    image: url(:/icons/chevron_up_accent.svg);
}

QComboBox::down-arrow:hover {
    image: url(:/icons/chevron_down_accent.svg);
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/chevron_down.svg);
}

QComboBox QAbstractItemView {
    background-color: #2c2c2c;
    border: 1px solid rgba(72, 72, 72, 0.22);
    border-radius: 5px;
    color: #e7e5e4;
    selection-background-color: #1f2020;
    selection-color: #71d7cd;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 22px;
    padding: 3px 8px;
    border: none;
}

/* ── QSpinBox / QDoubleSpinBox ───────────────────────────────────────────── */

QSpinBox, QDoubleSpinBox {
    background-color: #262626;
    color: #e7e5e4;
    border: none;
    border-bottom: 2px solid rgba(113, 215, 205, 0);
    border-radius: 5px;
    /* right padding clears the stacked stepper buttons */
    padding: 5px 26px 5px 10px;
    font-size: 11px;
    min-height: 18px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    background-color: #2c2c2c;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-bottom: 2px solid #71d7cd;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #2c2c2c;
    border: none;
    border-top-right-radius: 5px;
    width: 20px;
    subcontrol-origin: border;
    subcontrol-position: top right;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #2c2c2c;
    border: none;
    border-bottom-right-radius: 5px;
    width: 20px;
    subcontrol-origin: border;
    subcontrol-position: bottom right;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #484848;
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #1f2020;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/chevron_up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/chevron_down.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
    image: url(:/icons/chevron_up_accent.svg);
}

QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
    image: url(:/icons/chevron_down_accent.svg);
}

/* `:off` = the step is unavailable (value at min/max) — Qt's own idiom for
   greying a stepper out. */
QSpinBox::up-arrow:off, QSpinBox::down-arrow:off,
QDoubleSpinBox::up-arrow:off, QDoubleSpinBox::down-arrow:off {
    width: 10px;
    height: 10px;
}

/* ── QDateTimeEdit / QTimeEdit share QAbstractSpinBox's sub-controls ─────── */
QDateTimeEdit, QTimeEdit, QDateEdit {
    background-color: #262626;
    color: #e7e5e4;
    border: none;
    border-bottom: 2px solid rgba(113, 215, 205, 0);
    border-radius: 5px;
    padding: 5px 26px 5px 10px;
    font-size: 11px;
    min-height: 18px;
}

QDateTimeEdit::up-button, QTimeEdit::up-button, QDateEdit::up-button {
    background-color: #2c2c2c;
    border: none;
    width: 20px;
    subcontrol-origin: border;
    subcontrol-position: top right;
}

QDateTimeEdit::down-button, QTimeEdit::down-button, QDateEdit::down-button {
    background-color: #2c2c2c;
    border: none;
    width: 20px;
    subcontrol-origin: border;
    subcontrol-position: bottom right;
}

QDateTimeEdit::up-arrow, QTimeEdit::up-arrow, QDateEdit::up-arrow {
    image: url(:/icons/chevron_up.svg);
    width: 10px;
    height: 10px;
}

QDateTimeEdit::down-arrow, QTimeEdit::down-arrow, QDateEdit::down-arrow {
    image: url(:/icons/chevron_down.svg);
    width: 10px;
    height: 10px;
}

/* QCheckBox */
QCheckBox {
    background-color: #0e0e0e;
    color: #acabaa;
    font-size: 11px;
    spacing: 7px;
}

QCheckBox:hover { color: #e7e5e4; }

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    background-color: #262626;
    border: 1px solid rgba(72, 72, 72, 0.40);
}

QCheckBox::indicator:checked {
    background-color: #71d7cd;
    border-color: #71d7cd;
    image: url(:/icons/checked.svg);
}

QCheckBox::indicator:unchecked {
    image: url(:/icons/unchecked.svg);
}

/* QLabel */
QLabel {
    background-color: #0e0e0e;
    color: #acabaa;
    font-size: 11px;
}

/* QGroupBox */
QGroupBox {
    background-color: #191a1a;
    border: 1px solid rgba(72, 72, 72, 0.20);
    border-radius: 7px;
    margin-top: 16px;
    padding-top: 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #acabaa;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    background-color: #191a1a;
    color: #acabaa;
}

/* ── QTabWidget / QTabBar ────────────────────────────────────────────────────
   Tab labels were cramped: the tab metrics were computed from a 10px font set
   only on the ::tab subcontrol while the bar itself still used the app font,
   and the padding left no room for the label's descenders/side bearings. The
   panels that hurt most carry many tabs (SettingsPanel has 15 inside a dock).

   Sizing here is deliberately generous; the matching Qt-side properties that
   QSS cannot express (elideMode = ElideNone, usesScrollButtons, expanding =
   False) are set app-wide by src/ui/widget_polish.py, so overflow scrolls
   with the arrow buttons styled below instead of truncating the text. */

QTabWidget {
    background-color: #191a1a;
}

QTabWidget::pane {
    background-color: #191a1a;
    border: none;
    border-top: 1px solid rgba(72, 72, 72, 0.15);
    top: -1px;
}

QTabWidget::tab-bar {
    alignment: left;
    left: 4px;
}

QTabWidget > QWidget {
    background-color: #191a1a;
}

/* The font must be on QTabBar (not just ::tab) — Qt sizes each tab with the
   BAR's font metrics, so a font declared only on ::tab yields tabs measured
   for one size and painted at another. */
QTabBar {
    background-color: #131313;
    font-size: 11px;
    font-weight: 600;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #131313;
    color: #acabaa;
    padding: 8px 18px;
    min-width: 64px;
    min-height: 18px;
    font-size: 11px;
    font-weight: 600;
    border: none;
    border-bottom: 2px solid rgba(113, 215, 205, 0);
    margin-right: 3px;
}

QTabBar::tab:selected {
    background-color: #131313;
    color: #71d7cd;
    border-bottom: 2px solid #71d7cd;
}

QTabBar::tab:hover {
    background-color: #191a1a;
    color: #e7e5e4;
}

QTabBar::tab:disabled {
    color: rgba(172, 171, 170, 0.35);
}

/* Overflow scrollers: reachable, styled, and using the shared chevron set. */
QTabBar::scroller {
    width: 44px;
}

QTabBar QToolButton {
    background-color: #1f2020;
    border: 1px solid rgba(72, 72, 72, 0.35);
    border-radius: 3px;
    margin: 3px 1px;
    width: 18px;
}

QTabBar QToolButton:hover {
    background-color: #262626;
    border-color: #71d7cd;
}

QTabBar QToolButton:disabled {
    background-color: #131313;
    border-color: rgba(72, 72, 72, 0.18);
}

QTabBar QToolButton::left-arrow {
    image: url(:/icons/chevron_left.svg);
    width: 11px;
    height: 11px;
}

QTabBar QToolButton::right-arrow {
    image: url(:/icons/chevron_right.svg);
    width: 11px;
    height: 11px;
}

/* Vertical tab bars (West/East) need the padding transposed. */
QTabBar::tab:left,
QTabBar::tab:right {
    padding: 14px 8px;
    min-width: 18px;
    min-height: 64px;
}

/* ── QTreeView branch indicators ─────────────────────────────────────────────
   Any ::branch rule anywhere in the sheet makes QStyleSheetStyle take over
   PE_IndicatorBranch, and it paints nothing without an explicit `image`.
   These four state combinations are the full set Qt uses for an expandable
   node (with/without following siblings, open/closed); leaves are left
   imageless on purpose. */

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/chevron_right.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/chevron_down.svg);
}

QTreeView::branch:hover {
    background-color: #1f2020;
}

/* QHeaderView */
QHeaderView {
    background-color: #0e0e0e;
}

QHeaderView::section {
    background-color: #131313;
    color: #acabaa;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid rgba(72, 72, 72, 0.15);
    border-right: 1px solid rgba(72, 72, 72, 0.08);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
}

QHeaderView::section:hover {
    background-color: #191a1a;
    color: #e7e5e4;
}

/* QSlider global */
QSlider::groove:horizontal {
    height: 2px;
    background-color: #262626;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background-color: #71d7cd;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -5px 0;
}

QSlider::sub-page:horizontal {
    background-color: #71d7cd;
    border-radius: 1px;
}

QSlider::add-page:horizontal {
    background-color: #262626;
    border-radius: 1px;
}

/* QProgressBar */
QProgressBar {
    background-color: #262626;
    border: none;
    border-radius: 3px;
    color: #acabaa;
    font-size: 10px;
    text-align: center;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #71d7cd, stop:1 #0a8b82
    );
    border-radius: 3px;
}

/* Dialogs */
QDialog {
    background-color: #191a1a;
    color: #e7e5e4;
}

QDialog QWidget {
    background-color: #191a1a;
}

QDialog QLabel {
    background-color: #191a1a;
    color: #e7e5e4;
    font-size: 12px;
}

QDialog QAbstractItemView {
    background-color: #191a1a;
    alternate-background-color: #1f2020;
    color: #e7e5e4;
    border: none;
    outline: none;
    selection-background-color: #262626;
    selection-color: #71d7cd;
}

QDialog QAbstractScrollArea,
QDialog QAbstractScrollArea > QWidget,
QDialog QAbstractScrollArea > QWidget > QWidget {
    background-color: #191a1a;
}

QMessageBox {
    background-color: #191a1a;
    color: #e7e5e4;
}

QMessageBox QLabel {
    background-color: #191a1a;
    color: #e7e5e4;
    font-size: 12px;
}

QProgressDialog {
    background-color: #191a1a;
    color: #e7e5e4;
    border: 1px solid rgba(72, 72, 72, 0.22);
    border-radius: 8px;
}

QProgressDialog QLabel {
    background-color: #191a1a;
    color: #e7e5e4;
    font-size: 12px;
}

QFileDialog {
    background-color: #191a1a;
    color: #e7e5e4;
}

QFileDialog QWidget {
    background-color: #191a1a;
}

QFileDialog QAbstractItemView {
    background-color: #191a1a;
    color: #e7e5e4;
    border: none;
}

/* QToolTip */
QToolTip {
    background-color: #2c2c2c;
    color: #e7e5e4;
    border: 1px solid rgba(72, 72, 72, 0.25);
    border-radius: 5px;
    padding: 5px 9px;
    font-size: 10px;
    font-weight: 500;
}

/* MediaInfoPopup */
MediaInfoPopup {
    background-color: #2c2c2c;
    border: 1px solid rgba(72, 72, 72, 0.22);
    border-radius: 9px;
}

MediaInfoPopup QWidget {
    background-color: #2c2c2c;
}

MediaInfoPopup QLabel {
    background-color: #2c2c2c;
    color: #e7e5e4;
    font-size: 11px;
}

/* Ghost QFrame dividers */
QFrame[frameShape="4"] {
    background-color: rgba(72, 72, 72, 0.15);
    border: none;
    max-height: 1px;
}

QFrame[frameShape="5"] {
    background-color: rgba(72, 72, 72, 0.15);
    border: none;
    max-width: 1px;
}


/* ============================================================================
   10. VS CODE-LIKE EDGE DEFINITION
   Adds subtle gray boundaries so panel and control edges remain visible on dark
   surfaces without overpowering the teal accent.
   ============================================================================ */

QMainWindow {
    border: 1px solid #3c3c3c;
}

QWidget#stacks_panel,
QWidget#media_display,
QWidget#video_player_pane,
StacksListsPanel,
MediaDisplayWidget,
VideoPlayerWidget,
QDockWidget,
QDialog {
    border: 1px solid #3c3c3c;
}

QToolBar,
QMenuBar,
QStatusBar {
    border: none;
    border-top: 1px solid #2b2b2b;
    border-bottom: 1px solid #3c3c3c;
}

QStatusBar {
    border-top: 1px solid #3c3c3c;
    border-bottom: none;
}

QSplitter::handle {
    background-color: #2b2b2b;
    border: 1px solid #3c3c3c;
}

QSplitter::handle:hover {
    background-color: #3c3c3c;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    background-color: #3c3c3c;
    border: none;
}

QAbstractItemView,
QAbstractScrollArea,
QStackedWidget,
QTableView,
QTreeView,
QListView,
QListWidget,
QTreeWidget {
    border: 1px solid #2b2b2b;
    border-radius: 0;
}

QAbstractItemView:focus,
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #3c3c3c;
    border-bottom: 2px solid #71d7cd;
}

QHeaderView::section {
    border: none;
    border-right: 1px solid #2b2b2b;
    border-bottom: 1px solid #3c3c3c;
}

/* QToolButton is deliberately absent: the main toolbar is a strip of icon
   actions, and a 1px box around each one turned it into a row of buttons
   floating in boxes. Section 3 owns QToolButton chrome (flat, hover fill). */
QPushButton,
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QSlider::groove:horizontal,
QProgressBar {
    border: 1px solid #3c3c3c;
}

QPushButton:hover {
    border-color: #5a5a5a;
}

QPushButton:pressed,
QPushButton:checked {
    border-color: #71d7cd;
}

/* Borderless icon-only controls (search row, "+" in the nav headers).
   Declared after the generic border rule above so it wins without needing a
   more specific selector. See MediaDisplayWidget._as_tool_button. */
QPushButton[class="toolicon"],
QPushButton#toolicon {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px;
}

QPushButton[class="toolicon"]:hover,
QPushButton#toolicon:hover {
    background-color: #1f2020;
    border-color: rgba(72, 72, 72, 0.35);
}

QPushButton[class="toolicon"]:pressed,
QPushButton#toolicon:pressed {
    background-color: #262626;
    border-color: #71d7cd;
}

QPushButton[class="toolicon"]:checked,
QPushButton#toolicon:checked {
    background-color: rgba(113, 215, 205, 0.12);
    border-color: rgba(113, 215, 205, 0.45);
}

QPushButton[class="toolicon"]:disabled,
QPushButton#toolicon:disabled {
    background-color: transparent;
    border-color: transparent;
}

QMenu,
QToolTip,
QMessageBox,
QProgressDialog,
QFileDialog,
QGroupBox,
QTabWidget::pane,
MediaInfoPopup {
    border: 1px solid #3c3c3c;
}

/* Tabs use the underline (not a box) as their edge definition: a full 1px
   border here would re-introduce the boxed look AND eat 2px of the label's
   horizontal room on every tab. */
QTabBar::tab {
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    border: none;
    border-bottom: 2px solid #71d7cd;
}

QScrollBar:vertical {
    border-left: 1px solid #2b2b2b;
}

QScrollBar:horizontal {
    border-top: 1px solid #2b2b2b;
}


/* Explicit boundaries for the main visible work areas shown in the app shell. */
QWidget#app_root {
    background-color: #0e0e0e;
    border: 1px solid #4b5563;
}

QSplitter#main_splitter,
QSplitter#nav_main_splitter,
QSplitter#nav_section_splitter {
    background-color: #111111;
    border: 1px solid #4b5563;
}

QWidget#stacks_panel,
QWidget#media_display,
QWidget#video_player_pane {
    border: 1px solid #4b5563;
}

QWidget#playlists_container,
QWidget#stacks_container,
QWidget#tags_container,
QWidget#search_container,
QStackedWidget#media_content_stack,
QWidget#empty_state_widget,
QWidget#media_views_widget,
QStackedWidget#media_view_stack {
    background-color: #181818;
    border: 1px solid #4b5563;
}

QLabel#nav_title,
QLabel#section_header {
    background-color: #181818;
    color: #cccccc;
    border-bottom: 1px solid #4b5563;
}

QListWidget#playlists_list,
QTreeWidget#stacks_tree,
QListWidget#tags_list,
QListView#gallery_view,
QTableWidget#media_table_view,
QLineEdit#media_search_box {
    border: 1px solid #4b5563;
}

QLineEdit#media_search_box {
    background-color: #111111;
    border-radius: 0;
}

QLineEdit#media_search_box:focus {
    border: 1px solid #6b7280;
    border-bottom: 2px solid #71d7cd;
}
